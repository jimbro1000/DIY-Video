		(uuid "30ba7026-e1c8-43bc-95bc-4d69905291cc")
	)
	(text_box "Write data path latch. Uses the READ signal as it is the practical logical inverse of !WRITE in this context"
		(exclude_from_sim no)
		(at 120.65 100.33 0)
		(size 30.48 10.16)
		(margins 0.9525 0.9525 0.9525 0.9525)
