		(uuid "89c2762f-13d9-434e-ab9d-9a4dd21b2668")
	)
	(text_box "Read data path latch. Uses the WRITE signal as it is the practical logical inverse of !READ in this context"
		(exclude_from_sim no)
		(at 190.5 100.33 0)
		(size 30.48 10.16)
		(margins 0.9525 0.9525 0.9525 0.9525)
